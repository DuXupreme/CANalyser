<UserControl x:Class="CanAnalyzer.App.Views.DbcEditorView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:CanAnalyzer.App.Infrastructure"
             mc:Ignorable="d">
    <UserControl.Resources>
        <infra:FlexibleDoubleConverter x:Key="FlexDouble" />
        <infra:BooleanNegationConverter x:Key="NotBool" />
        <Style x:Key="RepairRowStyle" TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EAF2FB" />
                </Trigger>
                <DataTrigger Binding="{Binding IsRepairTarget}" Value="True">
                    <Setter Property="Background" Value="#FFF0D6" />
                    <Setter Property="BorderBrush" Value="#EC7A2D" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsRepairTarget}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#EC7A2D" />
                    <Setter Property="Foreground" Value="White" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RepairCellStyle" TargetType="DataGridCell">
            <Setter Property="ToolTip" Value="{Binding Tooltip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="120" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRepairTarget}" Value="True">
                    <Setter Property="Background" Value="#FFE1B5" />
                    <Setter Property="Foreground" Value="#4A2200" />
                    <Setter Property="BorderBrush" Value="#EC7A2D" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Visibility="{Binding FileToolbarVisibility, ElementName=Root}"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6"
                Margin="0,0,0,6">
            <WrapPanel>
                <Button Content="Nieuwe database" Command="{Binding NewDatabaseCommand}" Margin="0,0,6,0" />
                <Button Content="Open DBC..." Command="{Binding OpenDbcCommand}" Margin="0,0,6,0" />
                <Button Content="Opslaan als DBC..." Command="{Binding SaveDbcCommand}" Margin="0,0,12,0" />
                <Separator Margin="0,0,12,0" />
                <Button Content="+ Frame" Command="{Binding AddFrameCommand}" Margin="0,0,6,0" />
                <Button Content="- Frame" Command="{Binding RemoveFrameCommand}" />
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusText}"
                   ToolTip="{Binding StatusText}"
                   ToolTipService.InitialShowDelay="120"
                   Foreground="#444444"
                   TextTrimming="CharacterEllipsis"
                   Margin="2,0,0,6" />

        <!-- Master / detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Frame list -->
            <GroupBox Grid.Column="0" Header="Frames (berichten)">
                <DataGrid x:Name="FramesGrid"
                          ItemsSource="{Binding Frames}"
                          IsReadOnly="{Binding IsReadOnly}"
                          SelectedItem="{Binding SelectedFrame, Mode=TwoWay}"
                          RowStyle="{StaticResource RepairRowStyle}"
                          CellStyle="{StaticResource RepairCellStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding FrameIdText}" Width="90" />
                        <DataGridCheckBoxColumn Header="Ext" Binding="{Binding IsExtended}" Width="40" />
                        <DataGridTextColumn Header="Naam" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="DLC" Binding="{Binding Dlc}" Width="45" />
                        <DataGridTextColumn Header="#Sig" Binding="{Binding SignalCount}" Width="45" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#EEEEEE" />

            <!-- Detail -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Frame properties -->
                <GroupBox Grid.Row="0" Header="Frame-eigenschappen" Margin="0,0,0,6">
                    <WrapPanel Margin="6" IsEnabled="{Binding IsReadOnly, Converter={StaticResource NotBool}}">
                        <StackPanel Margin="0,0,12,4">
                            <TextBlock Text="Naam" />
                            <TextBox Width="180"
                                     Text="{Binding SelectedFrame.Name, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,4">
                            <TextBlock Text="CAN ID (hex of dec)" />
                            <TextBox Width="120" Text="{Binding SelectedFrame.FrameIdText}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,4">
                            <TextBlock Text="Extended" />
                            <CheckBox IsChecked="{Binding SelectedFrame.IsExtended}"
                                      Content="29-bit"
                                      VerticalAlignment="Center"
                                      Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,4">
                            <TextBlock Text="DLC (bytes)" />
                            <TextBox Width="60" Text="{Binding SelectedFrame.Dlc}" />
                        </StackPanel>
                    </WrapPanel>
                </GroupBox>

                <!-- Signals toolbar -->
                <DockPanel Grid.Row="1" Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Text="Signalen in geselecteerd frame"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right"
                            Content="- Signaal"
                            Command="{Binding RemoveSignalCommand}" />
                    <Button DockPanel.Dock="Right"
                            Content="+ Signaal"
                            Command="{Binding AddSignalCommand}"
                            Margin="0,0,6,0" />
                </DockPanel>

                <!-- Signals grid -->
                <DataGrid x:Name="SignalsGrid"
                          Grid.Row="2"
                          IsReadOnly="{Binding IsReadOnly}"
                          ItemsSource="{Binding SelectedFrame.Signals}"
                          SelectedItem="{Binding SelectedSignal, Mode=TwoWay}"
                          RowStyle="{StaticResource RepairRowStyle}"
                          CellStyle="{StaticResource RepairCellStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Naam" Binding="{Binding Name}" Width="150" />
                        <DataGridTextColumn Binding="{Binding StartBit}" Width="64">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Startbit" ToolTip="Eerste payloadbit van het signaal, volgens de gekozen bytevolgorde." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding Length}" Width="58">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Lengte" ToolTip="Aantal bits dat dit signaal gebruikt." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridCheckBoxColumn Binding="{Binding LittleEndian}" Width="52">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock Text="Intel" ToolTip="Aangevinkt: Intel/little-endian. Uit: Motorola/big-endian." />
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridCheckBoxColumn Binding="{Binding Signed}" Width="58">
                            <DataGridCheckBoxColumn.Header>
                                <TextBlock Text="Signed" ToolTip="Aangevinkt betekent dat negatieve ruwe waarden zijn toegestaan." />
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn Binding="{Binding Scale, Converter={StaticResource FlexDouble}}" Width="65">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Factor" ToolTip="Fysieke waarde = ruwe waarde × factor + offset." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Offset" Binding="{Binding Offset, Converter={StaticResource FlexDouble}}" Width="65" />
                        <DataGridTextColumn Header="Min" Binding="{Binding Minimum, Converter={StaticResource FlexDouble}}" Width="65" />
                        <DataGridTextColumn Header="Max" Binding="{Binding Maximum, Converter={StaticResource FlexDouble}}" Width="65" />
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60" />
                        <DataGridTextColumn Binding="{Binding MuxText}" Width="58">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Mux" ToolTip="M = mux-schakelaar; een getal = alleen actief bij die muxwaarde." />
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Validation -->
                <Border Grid.Row="3"
                        Background="#F7F7F7"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,3"
                        Margin="0,6,0,6">
                    <TextBlock Text="{Binding ValidationSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <!-- Bit layout -->
                <Expander x:Name="BitLayoutExpander"
                          Grid.Row="4"
                          Header="Bit-layout tonen (LSB0 - byte 0 boven, MSB links)"
                          IsExpanded="False">
                    <StackPanel Orientation="Horizontal" Margin="6">
                        <!-- Byte labels -->
                        <StackPanel>
                            <Border Height="16" />
                            <TextBlock Text="B0" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B1" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B2" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B3" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B4" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B5" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B6" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                            <TextBlock Text="B7" Height="26" Width="24" TextAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#666" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <!-- Bit-position header (MSB left) -->
                            <StackPanel Orientation="Horizontal" Height="16">
                                <TextBlock Text="7" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="6" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="5" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="4" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="3" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="2" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="1" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                                <TextBlock Text="0" Width="32" TextAlignment="Center" FontSize="10" Foreground="#666" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding BitCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="8" Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="30"
                                                Height="24"
                                                Margin="1"
                                                CornerRadius="2"
                                                Background="{Binding FillBrush}"
                                                ToolTip="{Binding Tooltip}"
                                                ToolTipService.InitialShowDelay="100"
                                                ToolTipService.ShowDuration="60000">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#BBBBBB" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelectedSignal}" Value="True">
                                                            <Setter Property="BorderBrush" Value="#B94B00" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding BitLabel}"
                                                       FontSize="9"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#333333" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Oranje = geselecteerd  |  rood = gelijktijdig conflict  |  gedeelde bits in gescheiden muxpaden zijn toegestaan"
                                       FontSize="10"
                                       Foreground="#888"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
