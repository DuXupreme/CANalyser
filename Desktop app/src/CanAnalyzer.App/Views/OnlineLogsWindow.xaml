<Window x:Class="CanAnalyzer.App.Views.OnlineLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanAnalyzer.App.Controls"
        Title="Online CANedge-logs"
        Icon="pack://application:,,,/CanAnalyzer;component/Resources/Branding/canalyser-icon.ico"
        Width="1280" Height="680" MinWidth="1050" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <DockPanel>
                <Button x:Name="SignOutButton" DockPanel.Dock="Right" Content="Afmelden" Padding="14,5"
                        Visibility="Collapsed" Click="OnSignOutClick" />
                <TextBlock Text="Online CANedge-logs" FontSize="22" FontWeight="SemiBold" />
            </DockPanel>
            <TextBlock Margin="0,5,0,3" Foreground="#5E6B75" TextWrapping="Wrap"
                       Text="Zoek op loggerdatum of ontvangst op de server. Zonder bevestigde tijdbron kan de loggerdatum afwijken. Een verschil met ontvangst bewijst geen achterstand. Tijden staan lokaal met UTC-offset. Markeringen zijn gedeeld met het dashboard; gemarkeerde bestanden worden bij downloaden overgeslagen." />
            <TextBlock Margin="0,0,0,14" Foreground="#5E6B75" TextWrapping="Wrap"
                       Text="Klik op een bestandsrij en kies Sessie toevoegen voor alle getoonde bestanden van die sessie. Binnen elke sessie moeten de delen opeenvolgend zijn. Downloads bewaren brongegevens en SHA-256 per bestand. De cache wordt vóór hergebruik gecontroleerd, na 7 dagen opgeruimd en tot circa 2 GB begrensd." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Machine" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="MachineBox" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="MachineId" />
            <ComboBox x:Name="TimeBasisBox" Grid.Column="2" SelectedIndex="0" SelectedValuePath="Tag" Margin="12,0,8,0" MinWidth="145">
                <ComboBoxItem Content="Loggerdatum vanaf" Tag="recording" />
                <ComboBoxItem Content="Ontvangstdatum vanaf" Tag="uploaded" />
            </ComboBox>
            <DatePicker x:Name="FromPicker" Grid.Column="3" />
            <TextBlock Grid.Column="4" Text="Tot en met" VerticalAlignment="Center" Margin="18,0,8,0" />
            <DatePicker x:Name="ToPicker" Grid.Column="5" />
            <Button x:Name="RefreshButton" Grid.Column="6" Content="Vernieuwen" Padding="14,5" Margin="18,0,0,0" Click="OnRefreshClick" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="520" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Recente selectie" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="RecentSelectionBox" Grid.Column="1" DisplayMemberPath="DisplayName" />
            <Button x:Name="RestoreSelectionButton" Grid.Column="2" Content="Opnieuw selecteren" Padding="14,5"
                    Margin="10,0,0,0" Click="OnRestoreSelectionClick" />
            <TextBlock x:Name="RecentSelectionHint" Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="#5E6B75" Text="Je laatste vijf downloadselecties blijven bewaard na opnieuw starten." />
        </Grid>

        <DataGrid x:Name="LogsGrid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="False" SelectionMode="Extended" GridLinesVisibility="Horizontal"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Kies" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                <DataGridTextColumn Header="Machine volgens bron" Binding="{Binding MachineDisplay}" Width="210" IsReadOnly="True" />
                <DataGridTextColumn Header="Sessie" Binding="{Binding Session}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="Bestand" Binding="{Binding Name}" Width="*" MinWidth="230" IsReadOnly="True" />
                <DataGridTextColumn Header="Gedeelde markering" Binding="{Binding AnnotationDisplay}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn Header="Log gestart (loggerklok)" Binding="{Binding RecordedDisplay}" SortMemberPath="RecordedAt" Width="210" IsReadOnly="True" />
                <DataGridTextColumn Header="Tijdkwaliteit" Binding="{Binding ClockDisplay}" Width="185" IsReadOnly="True" />
                <DataGridTextColumn Header="Ontvangen op server" Binding="{Binding UploadedDisplay}" SortMemberPath="UploadedAt" Width="210" IsReadOnly="True" />
                <DataGridTextColumn Header="Grootte" Binding="{Binding SizeDisplay}" Width="90" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Sessie toevoegen" Padding="10,4" Margin="0,0,8,0" Click="OnSelectSessionClick" />
                    <Button Content="Sessie uitvinken" Padding="10,4" Margin="0,0,8,0" Click="OnDeselectSessionClick" />
                    <Button Content="Alles selecteren" Padding="10,4" Margin="0,0,8,0" Click="OnSelectAllClick" />
                    <Button Content="Niets selecteren" Padding="10,4" Click="OnSelectNoneClick" />
                </StackPanel>
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox x:Name="ShowExcludedBox" Content="Gemarkeerde bestanden tonen" VerticalAlignment="Center" Margin="0,0,12,0"
                              Checked="OnShowExcludedChanged" Unchecked="OnShowExcludedChanged" />
                    <TextBlock Text="Reden" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="AnnotationReasonBox" Width="220" MaxLength="2000" ToolTip="Reden voor de markering van de gemarkeerde tabelrijen" Margin="0,0,8,0" />
                    <Button x:Name="MarkExcludedButton" Content="Markeer als niet nuttig" Click="OnMarkExcludedClick" Padding="10,4" Margin="0,0,8,0" />
                    <Button x:Name="UnmarkExcludedButton" Content="Markering verwijderen" Click="OnUnmarkExcludedClick" Padding="10,4" />
                </WrapPanel>
                <TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="#5E6B75" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Annuleren" Padding="14,6" Margin="0,0,8,0" Click="OnCancelClick" />
                <Button x:Name="DownloadButton" Content="Downloaden en analyseren" Padding="16,6" IsEnabled="False" Click="OnDownloadClick" />
            </StackPanel>
        </Grid>
        <Border x:Name="LoadingPanel" Grid.RowSpan="5" Panel.ZIndex="10" Background="#F2FFFFFF" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
                <Image Source="pack://application:,,,/Resources/Branding/canalyser-lockup.png" Width="340" Height="95" Stretch="Uniform" />
                <controls:TwistedWireLoader Width="210" Height="90" StrokeThickness="7" IsActive="True" Margin="0,20" />
                <TextBlock x:Name="LoadingPhase" FontSize="22" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar x:Name="LoadingProgress" Height="12" Margin="0,20" IsIndeterminate="True" Maximum="100" />
                <Button Content="Annuleren" Click="OnCancelClick" HorizontalAlignment="Center" Padding="22,8" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
