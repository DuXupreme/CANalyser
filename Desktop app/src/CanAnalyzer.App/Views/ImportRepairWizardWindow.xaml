<Window x:Class="CanAnalyzer.App.Views.ImportRepairWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanAnalyzer.App.Controls"
        xmlns:views="clr-namespace:CanAnalyzer.App.Views"
        Title="Importfouten oplossen"
        Icon="pack://application:,,,/Resources/Branding/canalyser-icon.ico"
        Width="1500"
        Height="900"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Closing="OnWindowClosing"
        PreviewKeyDown="OnPreviewKeyDown"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Importfouten oplossen" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="StepDescriptionText"
                           Margin="0,4,0,0"
                           Foreground="#4B5563"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1"
                    BorderBrush="#EC7A2D"
                    BorderThickness="0,0,0,3"
                    Padding="10,4"
                    VerticalAlignment="Top">
                <TextBlock x:Name="StepNumberText" FontWeight="SemiBold" Foreground="#1F5FA8" />
            </Border>
        </Grid>

        <Grid x:Name="OverviewPage" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Background="#FFF4E8"
                    BorderBrush="#EC7A2D"
                    BorderThickness="1"
                    Padding="10"
                    Margin="0,0,0,10">
                <TextBlock x:Name="OverviewSummaryText" TextWrapping="Wrap" />
            </Border>
            <DataGrid x:Name="IssuesGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionMode="Single"
                      SelectionChanged="OnIssueSelectionChanged">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#EAF2FB" Padding="6,4" Margin="0,5,0,1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Niveau" Binding="{Binding Severity}" Width="82" />
                    <DataGridTextColumn Header="Regel" Binding="{Binding SourceLineNumber}" Width="75" />
                    <DataGridTextColumn Header="Melding" Binding="{Binding Message}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <GroupBox Grid.Row="2" Header="Bronregel" Margin="0,10,0,0">
                <TextBox x:Name="SourceLineText"
                         Margin="8"
                         MinHeight="54"
                         MaxHeight="90"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>

        <ScrollViewer x:Name="RepairPage"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="CurrentFilesText"
                           Margin="0,0,0,10"
                           Foreground="#4B5563"
                           TextWrapping="Wrap" />
                <GroupBox Header="Logbestand herstellen" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="CleanLogCheckBox"
                                  Checked="OnRepairOptionChanged"
                                  Unchecked="OnRepairOptionChanged" />
                        <TextBlock Margin="22,5,0,8"
                                   Text="Alleen regels die de actieve CAN-parser expliciet heeft afgewezen worden uit een nieuwe kopie verwijderd. Het origineel blijft ongewijzigd."
                                   Foreground="#4B5563"
                                   TextWrapping="Wrap" />
                        <Grid IsEnabled="{Binding IsChecked, ElementName=CleanLogCheckBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="RepairedLogPathTextBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Bladeren..."
                                    Click="OnBrowseRepairedLogClick"
                                    Margin="8,0,0,0"
                                    Padding="10,3" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="DBC herstellen of vervangen" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid x:Name="DbcRepairActionPanel" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DbcIssueSummaryText"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Grid.Column="1"
                                    Content="DBC-fouten oplossen..."
                                    Click="OnOpenDbcRepairClick"
                                    Margin="12,0,0,0"
                                    Padding="12,4" />
                        </Grid>
                        <CheckBox x:Name="ReplaceDbcCheckBox"
                                  Content="Gebruik deze andere of gecorrigeerde DBC bij de nieuwe STRICT-poging"
                                  Checked="OnRepairOptionChanged"
                                  Unchecked="OnRepairOptionChanged" />
                        <Grid Margin="0,8,0,0"
                              IsEnabled="{Binding IsChecked, ElementName=ReplaceDbcCheckBox}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ReplacementDbcPathTextBox" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="Bladeren..."
                                    Click="OnBrowseReplacementDbcClick"
                                    Margin="8,0,0,0"
                                    Padding="10,3" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Verwacht resultaat">
                    <TextBlock x:Name="RepairPreviewText" Margin="10" TextWrapping="Wrap" />
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="DbcRepairPage" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFF8F0"
                    BorderBrush="#EC7A2D"
                    BorderThickness="1,1,1,3"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Content="Vorige fout" Click="OnPreviousDbcIssueClick" Padding="12,5" />
                            <Button Content="Volgende fout" Click="OnNextDbcIssueClick" Padding="12,5" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#C94F1D" Padding="8,3" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentDbcIssueCounterText"
                                           Foreground="White"
                                           FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="CurrentDbcIssueTitleText"
                                       Margin="10,0,0,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock x:Name="CurrentDbcIssueMeaningText"
                               Grid.Row="1"
                               Margin="0,9,0,0"
                               FontSize="13"
                               TextWrapping="Wrap" />

                    <Grid x:Name="DbcConflictPanel" Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="White" BorderBrush="#D6A97F" BorderThickness="1" Padding="9">
                            <StackPanel>
                                <TextBlock x:Name="ConflictLeftLabelText" FontWeight="SemiBold" Foreground="#7A3A12" />
                                <TextBlock x:Name="ConflictLeftSourceText"
                                           Margin="0,4,0,0"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="White" BorderBrush="#EC7A2D" BorderThickness="2" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="ConflictRightLabelText" FontWeight="SemiBold" Foreground="#A33D0B" />
                                <TextBlock x:Name="ConflictRightSourceText"
                                           Margin="0,4,0,0"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="3" Background="#EAF2FB" BorderBrush="#9EBFE3" BorderThickness="1" Padding="10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Aanbevolen oplossing" FontWeight="SemiBold" Foreground="#1F5FA8" />
                                <TextBlock x:Name="CurrentDbcIssueActionText" Margin="0,3,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="SuggestedFixResultText"
                                           Visibility="Collapsed"
                                           Margin="0,5,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="#26723A"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="SuggestedFixButton"
                                    Grid.Column="1"
                                    Visibility="Collapsed"
                                    Click="OnApplySuggestedFixClick"
                                    Margin="16,0,0,0"
                                    Padding="14,6"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Expander Grid.Row="4" Header="Technische details" Margin="0,8,0,0">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock x:Name="CurrentDbcIssueMessageText" TextWrapping="Wrap" />
                            <TextBox x:Name="CurrentDbcIssueSourceText"
                                     Margin="0,6,0,0"
                                     MaxHeight="62"
                                     IsReadOnly="True"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <views:DbcEditorView x:Name="DbcEditorHost" FileToolbarVisibility="Collapsed" />
                <Border x:Name="DbcLoadingOverlay"
                        Visibility="Collapsed"
                        Background="#EFFFFFFF">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:TwistedWireLoader Width="120"
                                                    Height="52"
                                                    StrokeThickness="6"
                                                    IsActive="True" />
                        <TextBlock x:Name="DbcLoadingText"
                                   Margin="0,8,0,0"
                                   FontWeight="SemiBold"
                                   Text="DBC voorbereiden..." />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RepairedDbcPathTextBox" VerticalContentAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Bladeren..."
                        Click="OnBrowseRepairedDbcClick"
                        Margin="8,0,0,0"
                        Padding="10,3" />
                <Button Grid.Column="2"
                        Content="Kopie opslaan en valideren"
                        Click="OnSaveAndValidateDbcClick"
                        Margin="8,0,0,0"
                        Padding="12,3" />
                <TextBlock x:Name="DbcValidationResultText"
                           Grid.Row="1"
                           Grid.ColumnSpan="3"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ContinuePartialButton"
                    Content="Bewust doorgaan als PARTIAL"
                    Click="OnContinuePartialClick"
                    HorizontalAlignment="Left"
                    Padding="12,4" />

            <StackPanel x:Name="OverviewButtons" Grid.Column="1" Orientation="Horizontal">
                <Button Content="Annuleren"
                        Click="OnCancelClick"
                        MinWidth="92"
                        Padding="10,4" />
                <Button Content="Fouten oplossen"
                        Click="OnNextClick"
                        IsDefault="True"
                        MinWidth="128"
                        Padding="10,4"
                        Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel x:Name="RepairButtons" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <Button Content="Terug" Click="OnBackClick" MinWidth="82" Padding="10,4" />
                <Button Content="Annuleren"
                        Click="OnCancelClick"
                        MinWidth="92"
                        Padding="10,4"
                        Margin="8,0,0,0" />
                <Button Content="STRICT opnieuw proberen"
                        Click="OnRetryStrictClick"
                        IsDefault="True"
                        MinWidth="172"
                        Padding="10,4"
                        Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel x:Name="DbcRepairButtons" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                <Button Content="Terug naar herstelkeuzes"
                        Click="OnBackFromDbcRepairClick"
                        MinWidth="166"
                        Padding="10,4" />
                <Button Content="Annuleren"
                        Click="OnCancelClick"
                        MinWidth="92"
                        Padding="10,4"
                        Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
