<UserControl x:Class="CanAnalyzer.App.Views.JoystickAnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:infra="clr-namespace:CanAnalyzer.App.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:CanAnalyzer.App.Views"
             xmlns:oxy="http://oxyplot.org/wpf"
             mc:Ignorable="d">
    <UserControl.Resources>
        <infra:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF8E5" BorderBrush="#E7C66C" BorderThickness="1" Padding="10" Margin="0,0,0,8">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers><DataTrigger Binding="{Binding HasUnsavedProfileChanges}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Bevestig en bewaar profiel" Command="{Binding ConfirmProfileCommand}" Margin="12,0,0,0" Padding="12,6" />
                <TextBlock Text="{Binding ProfileChangeStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedAnalysisTabIndex}">
            <TabItem Header="Overzicht"><views:AnalysisOverviewView /></TabItem>
            <TabItem Header="Reactietijd &amp; actuatorvolging">
                <views:ReactionAnalysisView />
            </TabItem>
            <TabItem Header="Joystickgebruik">
                <views:JoystickUsageView />
            </TabItem>

            <TabItem Header="CAN professioneel">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.0*" />
                        <RowDefinition Height="1.0*" />
                        <RowDefinition Height="1.1*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                        <WrapPanel>
                            <StackPanel Margin="0,0,8,0"><TextBlock Text="CAN-kanaal"/><ComboBox Width="140" ItemsSource="{Binding AvailableCanChannels}" SelectedItem="{Binding SelectedCanChannel, Mode=TwoWay}"/></StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Arbitration [kbps]" />
                                <TextBox Width="90"
                                         Text="{Binding CanBitrateKbps, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="FD data [kbps]" />
                                <TextBox Width="90"
                                         Text="{Binding CanDataBitrateKbps, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Venster [ms]" />
                                <TextBox Width="90"
                                         Text="{Binding CanTimeBinMilliseconds, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Acties" />
                                <Button Content="Herbereken" Command="{Binding RecomputeCommand}" />
                            </StackPanel>
                            <TextBlock Margin="0,7,0,0"
                                       Foreground="#555555"
                                       Text="Professionele CAN-overzichten: bus load/throughput, top-ID verkeer, cyclustijd en jitter per bericht-ID." />
                            <CheckBox Content="Deze bitrates zijn bevestigd voor alle machine-CAN-kanalen in dit profiel"
                                      IsChecked="{Binding CanBitratesConfirmed}" Margin="0,8,12,0" />
                            <Button Content="Profiel bevestigen en bewaren" Command="{Binding ConfirmProfileCommand}" Margin="0,8,0,0"/>
                        </WrapPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Bus metrics" Margin="0,0,6,0">
                            <DataGrid ItemsSource="{Binding ProfessionalCanMetrics}" AutoGenerateColumns="False" IsReadOnly="True" Margin="6" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Metric" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Waarde" Binding="{Binding Value}" Width="165" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Top CAN-IDs (verkeer)">
                            <DataGrid ItemsSource="{Binding ProfessionalTopIdRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="6" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding FrameIdHex}" Width="*" />
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="95" />
                                    <DataGridTextColumn Header="Aandeel [%]" Binding="{Binding SharePercent}" Width="95" />
                                    <DataGridTextColumn Header="Gem. bytes" Binding="{Binding MeanDlc}" Width="90" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding FrameType}" Width="95" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Frames/s over tijd" Margin="0,0,6,0">
                            <oxy:PlotView Model="{Binding CanFrameRateModel}" Margin="6" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Bus load [%] over tijd (geschat)">
                            <oxy:PlotView Model="{Binding CanBusLoadModel}" Margin="6" />
                        </GroupBox>
                    </Grid>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.0*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Top-ID aandeel plot" Margin="0,0,6,0">
                            <oxy:PlotView Model="{Binding CanTopIdPlotModel}" Margin="6" />
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Cyclustijd / jitter per ID (hoogste jitter eerst)">
                            <DataGrid ItemsSource="{Binding ProfessionalCycleRows}" AutoGenerateColumns="False" IsReadOnly="True" Margin="6" CanUserAddRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding FrameIdHex}" Width="*" />
                                    <DataGridTextColumn Header="Samples" Binding="{Binding Samples}" Width="80" />
                                    <DataGridTextColumn Header="Gem [ms]" Binding="{Binding AvgCycleMs}" Width="85" />
                                    <DataGridTextColumn Header="Jitter [ms]" Binding="{Binding JitterMs}" Width="85" />
                                    <DataGridTextColumn Header="Min [ms]" Binding="{Binding MinCycleMs}" Width="85" />
                                    <DataGridTextColumn Header="Max [ms]" Binding="{Binding MaxCycleMs}" Width="85" />
                                    <DataGridTextColumn Header="Negatief" Binding="{Binding NegativeCycles}" Width="75" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Actief gebruik en accuduur">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                    <views:ActiveUsageView DataContext="{Binding ActiveUsage}" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2"
                   Margin="2,6,2,0"
                   Text="{Binding StatusText}"
                   Foreground="#444444" />
    </Grid>
</UserControl>
