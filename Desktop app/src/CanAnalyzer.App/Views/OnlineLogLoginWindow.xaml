<Window x:Class="CanAnalyzer.App.Views.OnlineLogLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aanmelden bij online logs"
        Icon="pack://application:,,,/CanAnalyzer;component/Resources/Branding/canalyser-icon.ico"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <TextBlock Text="Aanmelden bij online logs" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#5E6B75"
                   Text="Gebruik dezelfde gebruikersnaam en hetzelfde wachtwoord als voor het CANedge-dashboard." />
        <Label Content="_Gebruikersnaam" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,5" />
        <TextBox x:Name="UsernameBox" Padding="6" />
        <Label Content="_Wachtwoord" Target="{Binding ElementName=PasswordInput}" Padding="0,12,0,5" />
        <PasswordBox x:Name="PasswordInput" Padding="6" />
        <CheckBox x:Name="RememberLoginBox" Content="Inloggegevens 30 dagen onthouden" Margin="0,14,0,0" />
        <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Firebrick"
                   Visibility="Collapsed" />
        <TextBlock Margin="0,16,0,20" TextWrapping="Wrap" Foreground="#5E6B75"
                   Text="Zonder vinkje geldt je aanmelding alleen zolang CANalyser open is. Met vinkje worden je gegevens versleuteld bewaard voor jouw Windows-account, maximaal 30 dagen. Afmelden verwijdert ze meteen." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuleren" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Aanmelden" IsDefault="True" Padding="14,6" Click="OnSignInClick" />
        </StackPanel>
    </StackPanel>
</Window>
