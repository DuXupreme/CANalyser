<UserControl x:Class="CanAnalyzer.App.Views.AnalysisOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F4F7FB">
  <StackPanel Margin="20">
   <TextBlock Text="Wat vertellen deze metingen?" FontSize="25" FontWeight="SemiBold" Foreground="#172B4D"/>
   <TextBlock Text="{Binding OverviewStatus}" TextWrapping="Wrap" Foreground="#52677F" Margin="0,8,0,18"/>
   <ItemsControl ItemsSource="{Binding OverviewCards}">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Border Width="410" Margin="0,0,14,14" Padding="18" CornerRadius="8" Background="White" BorderBrush="#DCE4EF" BorderThickness="1">
      <StackPanel>
       <TextBlock Text="{Binding State}" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,0,0,8"/>
       <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Answer}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,8"/>
       <TextBlock Text="{Binding Basis}" Foreground="#64748B" TextWrapping="Wrap"/>
       <Button Content="Bekijk metingen en uitleg" HorizontalAlignment="Left" Padding="12,6" Margin="0,14,0,0"
        Command="{Binding DataContext.InspectAnalysisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Expander Header="Signaalprofiel en bevestigde instellingen" Margin="0,8,0,0">
    <StackPanel Margin="8">
     <TextBlock Text="Bekende koppelingen en fysieke grenzen worden alleen hergebruikt voor een passende machine/installatie en DBC. Zonder bekende machine geldt het profiel uitsluitend voor dezelfde bronlog." TextWrapping="Wrap" Foreground="#52677F"/>
     <WrapPanel Margin="0,10,0,8">
      <TextBox Width="280" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,10,0"/>
      <Button Content="Bevestig en bewaar huidige instellingen" Command="{Binding ConfirmProfileCommand}" Padding="12,6"/>
     </WrapPanel>
     <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap"/>
    </StackPanel>
   </Expander>
  </StackPanel>
 </ScrollViewer>
</UserControl>
