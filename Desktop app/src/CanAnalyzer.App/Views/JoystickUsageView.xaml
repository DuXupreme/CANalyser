<UserControl x:Class="CanAnalyzer.App.Views.JoystickUsageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:infra="clr-namespace:CanAnalyzer.App.Infrastructure" xmlns:oxy="http://oxyplot.org/wpf" xmlns:views="clr-namespace:CanAnalyzer.App.Views">
    <UserControl.Resources>
        <infra:FlexibleDoubleConverter x:Key="FlexibleDoubleConverter" />
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F4F7FB">
        <StackPanel Margin="18" MinWidth="860" TextElement.Foreground="#172B4D" TextElement.FontSize="13">
            <Grid Margin="0,0,10,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Joystickgebruik" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Hoe vaak stuur je klein bij, en hoe lang houd je de joystick voluit?" Margin="0,5,0,0" Foreground="#64748B" />
                </StackPanel>
                <Button Grid.Column="1" Content="Bereken analyse" Command="{Binding RecomputeUsageCommand}" Background="#2563EB" Foreground="White" BorderThickness="0" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <CheckBox Content="Selecteer tijdvenster" IsChecked="{Binding UseJoystickTimeWindow}" VerticalAlignment="Center" Margin="0,0,18,10" />
                        <StackPanel Width="125" Margin="0,0,12,10">
                            <TextBlock Text="Start [s]" Style="{StaticResource Label}" />
                            <TextBox IsEnabled="{Binding UseJoystickTimeWindow}" Text="{Binding JoystickTimeStartSeconds, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Width="125" Margin="0,0,12,10">
                            <TextBlock Text="Einde [s]" Style="{StaticResource Label}" />
                            <TextBox IsEnabled="{Binding UseJoystickTimeWindow}" Text="{Binding JoystickTimeEndSeconds, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <Button Content="Volledige log" Command="{Binding ResetJoystickTimeWindowCommand}" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Foreground="#64748B" Margin="8,0,0,10">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Beschikbaar: {0:N1} – {1:N1} s">
                                    <Binding Path="JoystickAvailableStartSeconds" />
                                    <Binding Path="JoystickAvailableEndSeconds" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </WrapPanel>
                    <StackPanel Margin="0,8,0,8" HorizontalAlignment="Left">
                        <TextBlock Text="Herkende joystick" Style="{StaticResource Label}"/>
                        <ComboBox Width="300" ItemsSource="{Binding AvailableJoystickProfiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedJoystickProfile}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Joystick X" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AvailableSignals}" SelectedItem="{Binding SelectedJoystickXSignal, Mode=TwoWay}" ToolTip="{Binding SelectedJoystickXSignal}"/></StackPanel>
                        <StackPanel Width="300" Margin="0,0,12,10"><TextBlock Text="Joystick Y" Style="{StaticResource Label}"/><ComboBox ItemsSource="{Binding AvailableSignals}" SelectedItem="{Binding SelectedJoystickYSignal, Mode=TwoWay}" ToolTip="{Binding SelectedJoystickYSignal}"/></StackPanel>
                        <Button Content="Detecteer joystick" Command="{Binding AutoDetectJoystickPairCommand}" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding JoystickSetupNote}" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,8"/>
                    <Expander Header="Bekende joystickgrenzen per as" IsExpanded="{Binding JoystickSetupRequired, Mode=OneWay}">
                        <StackPanel Margin="0,10,0,6">
                            <TextBlock Text="Gebruik de waarden na decoderen: bijvoorbeeld −100 / 0 / 100 bij een as in procenten. Vul de werkelijke grenzen in; de uitersten van een willekeurige log zijn geen kalibratie." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="Procentassen: −100 / 0 / 100" Command="{Binding FillPercentJoystickCalibrationCommand}"/>
                                <Button Content="Genormaliseerd: −1 / 0 / 1" Command="{Binding FillNormalizedJoystickCalibrationCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="Een voorkeuze vult alleen de velden in. Controleer de waarden en bevestig hieronder dat ze voor deze joystick kloppen." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="X minimum"/><TextBox Text="{Binding JoystickXMinimum, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="X neutraal"/><TextBox Text="{Binding JoystickXNeutral, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,25,10"><TextBlock Text="X maximum"/><TextBox Text="{Binding JoystickXMaximum, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="Y minimum"/><TextBox Text="{Binding JoystickYMinimum, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="Y neutraal"/><TextBox Text="{Binding JoystickYNeutral, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="110" Margin="0,0,12,10"><TextBlock Text="Y maximum"/><TextBox Text="{Binding JoystickYMaximum, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            </WrapPanel>
                            <CheckBox Content="Dit zijn de bekende joystickgrenzen; gebruik ze voor neutraal, uitslag en voluit" IsChecked="{Binding UseJoystickCalibration}"/>
                            <Button Content="Bewaar bevestigde instellingen in profiel" Command="{Binding ConfirmProfileCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Foreground="#52677F" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Expander>
                    <Expander Header="Geavanceerd: neutraalgrens, voluitgrens en meetgaten" Margin="0,10,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Standaard is ≤ 10% neutraal, tot 30% klein, tot 60% middelgroot en vanaf 90% bijna/volledig voluit. De grootste uitslag van X of Y bepaalt de klasse. Alle tijden worden gewogen op gemeten seconden." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="Neutraalgrens [0–1]"/><TextBox Text="{Binding DeadzoneThreshold, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="145" Margin="0,0,12,0"><TextBlock Text="Voluitgrens [0–1]"/><TextBox Text="{Binding SaturationThreshold, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="155" Margin="0,0,12,0"><TextBlock Text="Max. sampleafstand [s]"/><TextBox Text="{Binding UsageMaximumGapSeconds, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                <StackPanel Width="110"><TextBlock Text="Histogramvakken"/><TextBox Text="{Binding HistogramBins, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding JoystickUsageStatus}" TextWrapping="Wrap" Foreground="#334155" Margin="0,4,10,12"/>
            <TextBlock Text="Hoe wordt de joystick bediend?" FontSize="18" FontWeight="SemiBold" Margin="0,0,10,10"/>
            <ItemsControl ItemsSource="{Binding JoystickAmplitudeCards}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Percentage}" FontSize="27" FontWeight="SemiBold" Foreground="{Binding Color}" Margin="0,5,0,0"/>
                            <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Height="5" Maximum="100" Foreground="{Binding Color}" Background="#E8EEF7" BorderThickness="0" Margin="0,6,0,8"/>
                            <TextBlock Text="{Binding Duration}" Foreground="#475569"/>
                            <TextBlock Text="{Binding Range}" Foreground="#64748B" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Korte kleine correcties" Style="{StaticResource Label}"/><TextBlock Text="{Binding JoystickCorrectionCountText}" FontSize="25" FontWeight="SemiBold" Foreground="#0D9488"/><TextBlock Text="{Binding JoystickCorrectionDurationText}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Voluit vasthouden ≥ 2 s" Style="{StaticResource Label}"/><TextBlock Text="{Binding JoystickFullHoldCountText}" FontSize="25" FontWeight="SemiBold" Foreground="#B45309"/><TextBlock Text="{Binding JoystickFullHoldDurationText}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gezamenlijk gemeten tijd" Style="{StaticResource Label}"/><TextBlock Text="{Binding JoystickMeasuredTimeText}" FontSize="25" FontWeight="SemiBold" Foreground="#2563EB"/><TextBlock Text="{Binding JoystickMissingTimeText}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,6,0,0"/></StackPanel></Border>
            </UniformGrid>
            <TextBlock Text="{Binding JoystickInputDefinition}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,10,12"/>
            <Expander Header="Controleer afzonderlijke bedieningen" Margin="0,0,10,12">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0"><StackPanel>
                    <TextBlock Text="{Binding JoystickEventListNote}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,10"/>
                    <DataGrid ItemsSource="{Binding JoystickInputRows}" SelectedItem="{Binding SelectedJoystickInput, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MaxHeight="240" MinHeight="90">
                        <DataGrid.Columns><DataGridTextColumn Header="Bediening" Binding="{Binding Kind}" Width="*"/><DataGridTextColumn Header="Start in log" Binding="{Binding Start}" Width="130"/><DataGridTextColumn Header="Duur" Binding="{Binding Duration}" Width="130"/><DataGridTextColumn Header="Grootste uitslag" Binding="{Binding Peak}" Width="140"/></DataGrid.Columns>
                    </DataGrid>
                    <views:TimePlotView InteractionGroup="joystick-input" Model="{Binding JoystickInputPreviewModel}" Height="320" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding JoystickInputPreviewNote}" TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/>
                </StackPanel></Border>
            </Expander>
            <TextBlock Text="Verdeling en richting" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
            <TextBlock Text="De puntenwolk toont waar de joystick staat. De radiusgrafiek combineert X en Y; de kaarten hierboven gebruiken de grootste afzonderlijke asuitslag." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,10,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Viewbox Stretch="Uniform">
                        <oxy:PlotView Model="{Binding JoystickDensityModel}" Width="440" Height="370" />
                    </Viewbox>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <oxy:PlotView Model="{Binding RadiusHistogramModel}" MinHeight="320" />
                </Border>
            </Grid>
            <Expander Header="Traject afspelen · kort spoor van 5 seconden" Margin="0,5,10,12">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                            <TextBlock Text="Volg een beweging zonder de hele log over elkaar te tekenen." TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel>
                                <CheckBox Content="Afspeelpositie gebruiken" IsChecked="{Binding IsJoystickPlaybackEnabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Play / pauze" Command="{Binding ToggleJoystickPlaybackCommand}" />
                                <Button Content="Naar begin" Command="{Binding ResetJoystickPlaybackCommand}" />
                            </WrapPanel>
                            <Slider Minimum="{Binding JoystickPlaybackStartSeconds}" Maximum="{Binding JoystickPlaybackEndSeconds}" Value="{Binding JoystickPlaybackPositionSeconds}" IsEnabled="{Binding IsJoystickPlaybackEnabled}" Margin="0,16,0,8" />
                            <TextBlock Text="{Binding JoystickPlaybackPositionSeconds, StringFormat=Tijd: {0:N2} s}" Margin="0,0,0,10" />
                            <StackPanel Width="110" Margin="0,0,12,10">
                                <TextBlock Text="Snelheid ×" Style="{StaticResource Label}" />
                                <TextBox Text="{Binding JoystickPlaybackSpeed, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                            <TextBlock Text="De gebruikscijfers en dichtheid blijven over het hele gekozen tijdvenster berekend." TextWrapping="Wrap" Foreground="#64748B" />
                        </StackPanel>
                        <oxy:PlotView Grid.Column="1" Model="{Binding TrajectoryModel}" Width="330" Height="310" />
                    </Grid>
                </Border>
            </Expander>
            <Expander Header="Berekeningsdetails" Margin="0,0,10,10">
                <ItemsControl ItemsSource="{Binding JoystickUsageMetrics}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#64748B" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <Expander Header="Aanvullend: actuatorbereik en slagbenutting" Margin="0,8,10,12">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Dit is een aparte analyse. Bekend nulpunt en beschikbaar halfbereik zijn alleen nodig om te bepalen of een actuator dicht bij zijn grenzen werkt; joystickgebruik hierboven werkt hiervan onafhankelijk." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,0,12"/>
                    <Expander Header="Actuatorsignalen en bereik instellen">
                        <StackPanel Margin="0,10,0,12">
                            <WrapPanel>
                                <StackPanel Width="280" Margin="0,0,12,10">
                                    <TextBlock Text="Actuator links · gemeten positie" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding AvailableSignals}" SelectedItem="{Binding SelectedActuatorLeftSignal, Mode=TwoWay}" ToolTip="{Binding SelectedActuatorLeftSignal}" />
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,12,10">
                                    <TextBlock Text="Actuator rechts · gemeten positie" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding AvailableSignals}" SelectedItem="{Binding SelectedActuatorRightSignal, Mode=TwoWay}" ToolTip="{Binding SelectedActuatorRightSignal}" />
                                </StackPanel>
                                <StackPanel Width="280" Margin="0,0,12,10">
                                    <TextBlock Text="Actuator voor · gemeten positie" Style="{StaticResource Label}" />
                                    <ComboBox ItemsSource="{Binding AvailableSignals}" SelectedItem="{Binding SelectedActuatorFrontSignal, Mode=TwoWay}" ToolTip="{Binding SelectedActuatorFrontSignal}" />
                                </StackPanel>
                            </WrapPanel>
                            <Button Content="Detecteer actuatorfeedback" Command="{Binding AutoDetectActuatorPairCommand}" HorizontalAlignment="Left"/>
                            <StackPanel Width="140" HorizontalAlignment="Left" Margin="0,10,0,10"><TextBlock Text="Grensband [%]"/><TextBox Text="{Binding StrokeEdgePercent, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                            <TextBlock Text="Alle posities, nulpunten en halfbereiken moeten dezelfde gedecodeerde eenheid gebruiken. 150 eenheden is alleen 15 mm bij 0,1 mm per eenheid; kies 15 wanneer de signalen al in mm staan." TextWrapping="Wrap" Foreground="#64748B" Margin="0,12,0,8" />
                            <ItemsControl ItemsSource="{Binding ActuatorRanges}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <GroupBox Header="{Binding Name}" Margin="0,6,0,6" Padding="8">
                                        <WrapPanel>
                                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Gekalibreerd nulpunt · signaal"/><ComboBox ItemsSource="{Binding DataContext.OptionalSignals, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding CenterSignal, Mode=TwoWay}" /></StackPanel>
                                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Werkelijk absoluut setpoint"/><ComboBox ItemsSource="{Binding DataContext.OptionalSignals, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding SetpointSignal, Mode=TwoWay}" /></StackPanel>
                                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Halfbereik · optioneel signaal"/><ComboBox ItemsSource="{Binding DataContext.OptionalSignals, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding HalfRangeSignal, Mode=TwoWay}" /></StackPanel>
                                            <StackPanel Width="260" Margin="0,0,12,10"><TextBlock Text="Bedrijfsstatus · optioneel"/><ComboBox ItemsSource="{Binding DataContext.OptionalSignals, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding RunSignal, Mode=TwoWay}" /></StackPanel>
                                            <StackPanel Width="160" Margin="0,0,12,10"><TextBlock Text="Of vast nulpunt"/><TextBox Text="{Binding ManualCenter, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                            <StackPanel Width="160" Margin="0,0,12,10"><TextBlock Text="Vast halfbereik"/><TextBox Text="{Binding HalfRange, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                            <StackPanel Width="160" Margin="0,0,12,10"><TextBlock Text="Waarde tijdens bedrijf"/><TextBox Text="{Binding RunValue, Converter={StaticResource FlexibleDoubleConverter}, UpdateSourceTrigger=LostFocus}" /></StackPanel>
                                        </WrapPanel>
                                    </GroupBox>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Bewaar alleen bekende nulpunten en halfbereiken. Bevestigen bewaart deze grenzen met hun exacte signalen voor volgende metingen van dezelfde installatie en DBC."
                                       TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,6" />
                            <Button Content="Bekende actuatorgrenzen bevestigen en bewaren" Command="{Binding ConfirmProfileCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding ProfileStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="Nulpunt- en halfbereiksignalen gaan vóór vaste waarden. Gebruik het werkelijk beschikbare bereik per actuator; dit kan kleiner zijn door de aansturing of veranderen met snelheid. Kies dan een halfbereiksignaal of analyseer perioden met een bekend vast bereik apart. Lege signaalkeuze schakelt een optioneel signaal uit." TextWrapping="Wrap" Foreground="#64748B" />
                        </StackPanel>
                    </Expander>
            <TextBlock Text="Slagbenutting per actuator" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,5" />
            <TextBlock Text="0% = nulpunt − halfbereik · 50% = nulpunt · 100% = nulpunt + halfbereik. Veel tijd aan een grens is een aanwijzing voor beperkt regelbereik; geen bewijs hoeveel extra slag nodig is." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,10,12" />
            <ItemsControl ItemsSource="{Binding StrokeCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Signal}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Signal}" Foreground="#64748B" Margin="0,4,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Used}" FontSize="30" FontWeight="SemiBold" />
                                    <TextBlock Text="tijd nabij grenzen" Margin="9,0,0,5" VerticalAlignment="Bottom" Foreground="#64748B" />
                                </StackPanel>
                                <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Maximum="100" Height="6" Foreground="{Binding Color}" Background="#E8EEF7" BorderThickness="0" Margin="0,8,0,10" />

                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Bereik selectie" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="{Binding WindowRange}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="P01–P99" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="{Binding RobustRange}" FontWeight="SemiBold" />
                                </Grid>
                                <Separator Margin="0,10,0,6" />
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tijd nabij minimum" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="{Binding Low}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Tijd nabij maximum" Foreground="#64748B" />
                                    <TextBlock Grid.Column="1" Text="{Binding High}" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Buiten referentiebereik" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Outside}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Bezoeken laag / hoog" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Visits}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Langste verblijf laag / hoog" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding Longest}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Setpoint bij laag / hoog" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding CommandEdges}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Beide bij laag / hoog" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding BothEdges}" FontWeight="SemiBold" /></Grid>
                                <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Gem. volgafwijking" Foreground="#64748B"/><TextBlock Grid.Column="1" Text="{Binding TrackingError}" FontWeight="SemiBold" /></Grid>
                                <TextBlock Text="{Binding Coverage}" Foreground="#64748B" Margin="0,12,0,3" />
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#64748B" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="P01–P99 is tijdgewogen. Grenspercentages gebruiken beoordeelde meettijd; setpointcijfers alleen gezamenlijke dekking. Buiten-bereikwaarden staan apart en worden niet op 0/100% geklemd. Bezoeken zijn aaneengesloten perioden binnen de grensband (standaard 5%)." TextWrapping="Wrap" Foreground="#64748B" Margin="0,0,10,10" />
            <Expander Header="Waar in de slag zitten de actuatoren?" Margin="0,0,10,14">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <oxy:PlotView Model="{Binding StrokeDistributionModel}" Height="260" />
                </Border>
            </Expander>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
