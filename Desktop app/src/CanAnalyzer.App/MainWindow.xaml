<Window x:Class="CanAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CanAnalyzer.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:CanAnalyzer.App.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Resources/Branding/canalyser-icon.ico"
        MinWidth="1200"
        MinHeight="760">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Bestand">
                <MenuItem Header="_Online CANedge-logs..." Command="{Binding ImportOnlineLogsCommand}" />
                <MenuItem Header="_CAN-log kiezen..." Command="{Binding BrowseLogFileCommand}" />
                <MenuItem Header="_Database kiezen..." Command="{Binding BrowseDbcFileCommand}" />
                <MenuItem Header="_Actuator CSV..." Command="{Binding ImportActuatorCsvCommand}" />
                <Separator />
                <MenuItem Header="_Laden / Decoderen" Command="{Binding LoadAndDecodeCommand}" />
                <MenuItem Header="_Annuleren" Command="{Binding CancelCommand}" />
                <Separator />
                <MenuItem Header="Export _CSV..." Command="{Binding ExportDecodedCsvCommand}" />
                <MenuItem Header="_Machine-analyse exporteren" Command="{Binding ExportAnalysesCommand}" />
                <MenuItem Header="Export _Layout..." Command="{Binding ExportLayoutCommand}" />
                <MenuItem Header="Import L_ayout..." Command="{Binding ImportLayoutCommand}" />
                <Separator />
                <MenuItem Header="A_fsluiten" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Venster">
                <MenuItem Header="Losse _Signal Watch" Command="{x:Static views:SignalWatchWindow.OpenCommand}" />
            </MenuItem>
            <MenuItem Header="_Info" Click="OnAboutClick" />
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Image Source="pack://application:,,,/Resources/Branding/canalyser-lockup.png"
                       Width="145"
                       Height="34"
                       Margin="4,0,12,0"
                       Stretch="Uniform"
                       Focusable="False"
                       ToolTip="CANalyser"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <Separator />
                <Button Content="Online logs" Command="{Binding ImportOnlineLogsCommand}"
                        ToolTip="Kies CANedge-logs per machine en periode, download ze en start direct de analyse." />
                <Button Content="Log kiezen" Command="{Binding BrowseLogFileCommand}"
                        ToolTip="Kies een logbestand; Laden/Decoderen opent de gekozen log en DBC samen." />
                <Button Content="DBC kiezen" Command="{Binding BrowseDbcFileCommand}"
                        ToolTip="Kies de CAN-database voor de volgende import." />
                <Button Content="Actuator CSV" Command="{Binding ImportActuatorCsvCommand}"
                        ToolTip="Selecteer meerdere Actuator Testbench CSV-logs; CANalyser lijnt hun eerste doelstap uit op t=0." />
                <Separator />
                <Button Content="Laden/Decoderen" Command="{Binding LoadAndDecodeCommand}" />
                <Button Content="Annuleren" Command="{Binding CancelCommand}" />
                <Button Content="Signal Watch" Command="{x:Static views:SignalWatchWindow.OpenCommand}"
                        ToolTip="Open de gevolgde signalen in een klein los venster dat boven je grafieken kan blijven staan." />
                <Separator />
                <Button Content="Export CSV" Command="{Binding ExportDecodedCsvCommand}" />
                <Button Content="Machine-analyse exporteren" Command="{Binding ExportAnalysesCommand}"
                        ToolTip="Exporteer de volledige opname met vaste analyses en minuuttrends, onafhankelijk van de huidige schermselectie." />
                <Button Content="Export Layout" Command="{Binding ExportLayoutCommand}" />
                <Button Content="Import Layout" Command="{Binding ImportLayoutCommand}" />
            </ToolBar>
        </ToolBarTray>

        <StackPanel DockPanel.Dock="Top" Margin="8,2,8,6">
            <TextBlock Text="{Binding LoadedSourceSummary}" TextTrimming="CharacterEllipsis" />
            <Border Background="#FFFFF3CD" BorderBrush="#FFE4C35D" BorderThickness="1" Padding="8" Margin="0,4,0,0"
                    Visibility="{Binding ShowSourceSelectionNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Content="Laden/Decoderen" Command="{Binding LoadAndDecodeCommand}" Padding="10,4" />
                        <Button Content="Huidige opname behouden" Command="{Binding KeepLoadedSourceSelectionCommand}" Padding="10,4" Margin="6,0,0,0"
                                Visibility="{Binding HasPendingSourceSelection, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SourceSelectionNotice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="240" />
                <RowDefinition Height="6" />
                <RowDefinition Height="125" MinHeight="38" />
            </Grid.RowDefinitions>
            <GridSplitter x:Name="InfoResizeGrip" Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                          Cursor="SizeNS" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                          Background="#FFD0D0D0" KeyboardIncrement="10"
                          ToolTip="Sleep om de hoogte van de informatiebalk te wijzigen"
                          AutomationProperties.Name="Hoogte informatiebalk" />
        <StatusBar Grid.Row="2" VerticalContentAlignment="Stretch">
            <StatusBarItem>
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <controls:TwistedWireLoader Width="52"
                                                Height="24"
                                                Margin="0,0,0,2"
                                                HorizontalAlignment="Center"
                                                StrokeThickness="3.8"
                                                IsActive="{Binding IsBusyIndicatorVisible}"
                                                Visibility="{Binding IsBusyIndicatorVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{Binding ActiveProgressLabel}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Width="220">
                <ProgressBar Height="16"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding IsBackgroundAnalysisBusy}"
                             Value="{Binding ProgressValue}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Fouten oplossen"
                            Command="{Binding RepairPartialImportCommand}"
                            Visibility="{Binding HasRepairablePartialImport, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,10,0"
                            Padding="10,2"
                            ToolTip="Open de herstelwizard voor deze PARTIAL-import." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding StatusText}" />
                    </ScrollViewer>
                </DockPanel>
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedMainTabIndex}">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem Header="Analyse">
                <views:AnalysisView DataContext="{Binding Analysis}" />
            </TabItem>
            <TabItem Header="Inzichten">
                <views:JoystickAnalyticsView DataContext="{Binding JoystickAnalytics}" />
            </TabItem>
            <TabItem Header="Raw Frames (PCAN)">
                <views:RawFramesView DataContext="{Binding RawFrames}" />
            </TabItem>
            <TabItem Header="Busmaster">
                <views:BusmasterView x:Name="BusmasterPanel" DataContext="{Binding Busmaster}" />
            </TabItem>
            <TabItem Header="Database (DBC)">
                <views:DbcEditorView DataContext="{Binding DbcEditor}" />
            </TabItem>
            <TabItem Header="Vergelijken">
                <views:ComparisonView DataContext="{Binding Comparison}" />
            </TabItem>
            <TabItem Header="Instellingen / Diagnostics">
                <views:SettingsDiagnosticsView DataContext="{Binding SettingsDiagnostics}" />
            </TabItem>
        </TabControl>
        <Border Grid.RowSpan="3" Panel.ZIndex="10" Background="#EEFFFFFF"
                Visibility="{Binding ShowDatasetLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="650">
                <Image Source="pack://application:,,,/Resources/Branding/canalyser-lockup.png"
                       Width="340" Height="95" Stretch="Uniform" Margin="0,0,0,18" />
                <controls:TwistedWireLoader Width="210" Height="90" StrokeThickness="7"
                                            IsActive="{Binding ShowDatasetLoading}" />
                <TextBlock Text="{Binding ActiveProgressLabel}" FontSize="22" TextAlignment="Center" Margin="0,18,0,8" />
                <TextBlock Text="{Binding LoadingSourceName}" TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="12" Margin="0,20,0,12" />
                <Button Content="Annuleren" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Padding="22,8" />
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>
</Window>
